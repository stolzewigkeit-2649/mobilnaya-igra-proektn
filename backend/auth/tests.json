    {
      "name": "Список сервисов входа",
      "method": "GET",
      "path": "/?action=providers",
      "expectedStatus": 200,
      "expectedBody": {},
      "bodyMatcher": "partial"
    },
    {
      "name": "Без токена игрок пустой",
      "method": "GET",
      "path": "/?action=me",
      "expectedStatus": 200,
      "expectedBody": {"player": null},
      "bodyMatcher": "partial"
    },
    {
      "name": "Неизвестный провайдер отклоняется",
